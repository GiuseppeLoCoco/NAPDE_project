from firedrake import *
import sys, os

t_parameter = Constant(0.0)

def get_inflow_profile(mesh):
    X = SpatialCoordinate(mesh)
    return 6.0 * X[1] * (4.1 - X[1]) / (4.1 * 4.1) * sin(2.0 * PI * t_param / 10.0)

def time_varying_bc(tt):
    t_param.assign(tt)

def create_boundary_conditions(fluid_mesh, **V):
    inflow_profile = get_inflow_profile(fluid_mesh.mesh)
    bcu_inflow_x = DirichletBC(V['fluid'][0], inflow_profile, 1)
    bcu_walls_x = DirichletBC(V['fluid'][0], Constant(0.0), 3)
    bcu_inflow_y = DirichletBC(V['fluid'][0], Constant(0.0), 1)
    bcu_walls_y = DirichletBC(V['fluid'][0], Constant(0.0), 3)

    bcu = [[bcu_walls_x, bcu_inflow_x], [bcu_inflow_y, bcu_walls_y]]

    bcp_outflow = DirichletBC(V['fluid'][1], Constant(0.0), 2)
    bcp = [bcp_outflow]


    return dict(velocity=bcu, pressure=bcp)

